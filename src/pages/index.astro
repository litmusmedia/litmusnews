    <!-- CLIENT SCRIPT: SPOTLIGHT, LOCALIZATION & INTERACTIVITY -->
    <script is:inline>
      // 1. Interactive Terracotta Illumination Spotlight
      const spotlight = document.getElementById('spotlight');
      let targetX = 50;
      let targetY = 40;
      let currentX = 50;
      let currentY = 40;

      function updateSpotlightPos(clientX, clientY) {
        targetX = (clientX / window.innerWidth) * 100;
        targetY = (clientY / window.innerHeight) * 100;
      }

      window.addEventListener('mousemove', (e) => {
        updateSpotlightPos(e.clientX, e.clientY);
      }, { passive: true });

      window.addEventListener('touchmove', (e) => {
        if (e.touches && e.touches.length > 0) {
          updateSpotlightPos(e.touches[0].clientX, e.touches[0].clientY);
        }
      }, { passive: true });

      // Smooth interpolation for subtle feel
      function animateSpotlight() {
        currentX += (targetX - currentX) * 0.12;
        currentY += (targetY - currentY) * 0.12;
        if (spotlight) {
          spotlight.style.setProperty('--mouse-x', `${currentX.toFixed(2)}%`);
          spotlight.style.setProperty('--mouse-y', `${currentY.toFixed(2)}%`);
        }
        requestAnimationFrame(animateSpotlight);
      }
      requestAnimationFrame(animateSpotlight);

      // 2. Language State & Localization Handling (Default: Hindi 'hi')
      let currentLang = 'hi';

      const metaTitle = document.getElementById('meta-title');
      const metaDesc = document.getElementById('meta-desc');
      const ogTitle = document.getElementById('og-title');
      const ogDesc = document.getElementById('og-desc');
      const langBtnHi = document.getElementById('lang-btn-hi');
      const langBtnEn = document.getElementById('lang-btn-en');

      const metaContent = {
        hi: {
          title: "द लिटमस न्यूज़ | The Litmus News - राजस्थान की निष्पक्ष आवाज़",
          description: "राजस्थान का अग्रणी हाइपर-लोकल डिजिटल न्यूज़ नेटवर्क। ज़मीनी रिपोर्टिंग, प्रशासनिक पड़ताल, संस्कृति और जन सरोकार।"
        },
        en: {
          title: "The Litmus News | Rajasthan's Pulse Online - Regional News Agency",
          description: "Rajasthan's premier hyper-localized digital newsroom. Independent grassroots journalism, administrative scrutiny, and regional stories."
        }
      };

      function setLanguage(lang) {
        currentLang = lang;
        document.documentElement.lang = lang;

        // Update Toggle Buttons
        if (lang === 'hi') {
          langBtnHi?.classList.add('active');
          langBtnHi?.setAttribute('aria-pressed', 'true');
          langBtnEn?.classList.remove('active');
          langBtnEn?.setAttribute('aria-pressed', 'false');
        } else {
          langBtnEn?.classList.add('active');
          langBtnEn?.setAttribute('aria-pressed', 'true');
          langBtnHi?.classList.remove('active');
          langBtnHi?.setAttribute('aria-pressed', 'false');
        }

        // Update Meta Tags
        if (metaTitle) metaTitle.textContent = metaContent[lang].title;
        if (metaDesc) metaDesc.setAttribute('content', metaContent[lang].description);
        if (ogTitle) ogTitle.setAttribute('content', metaContent[lang].title);
        if (ogDesc) ogDesc.setAttribute('content', metaContent[lang].description);

        // Update standard text nodes
        document.querySelectorAll('.i18n').forEach((el) => {
          const val = el.getAttribute(`data-${lang}`);
          if (val) {
            el.textContent = val;
          }
        });

        // Update HTML rich nodes (headlines with span)
        document.querySelectorAll('.i18n-html').forEach((el) => {
          const htmlVal = el.getAttribute(`data-${lang}`);
          if (htmlVal) {
            el.innerHTML = htmlVal;
          }
        });

        // Update attributes (like placeholder)
        document.querySelectorAll('.i18n-attr').forEach((el) => {
          const placeholderVal = el.getAttribute(`data-placeholder-${lang}`);
          if (placeholderVal) {
            el.setAttribute('placeholder', placeholderVal);
          }
        });

        // Save preference in localStorage
        try {
          localStorage.setItem('litmus_preferred_lang', lang);
        } catch (e) {
          // ignore localStorage limitations
        }
      }

      // Attach Language Switcher events
      langBtnHi?.addEventListener('click', () => setLanguage('hi'));
      langBtnEn?.addEventListener('click', () => setLanguage('en'));

      // Check for user preference on load (keeping Hindi as default if none set)
      try {
        const savedLang = localStorage.getItem('litmus_preferred_lang');
        if (savedLang === 'en' || savedLang === 'hi') {
          setLanguage(savedLang);
        } else {
          setLanguage('hi');
        }
      } catch (e) {
        setLanguage('hi');
      }

      // 3. Mobile Navigation Drawer Toggle
      const mobileNavToggle = document.getElementById('mobile-nav-toggle');
      const mobileDrawer = document.getElementById('mobile-drawer');

      mobileNavToggle?.addEventListener('click', () => {
        mobileDrawer?.classList.toggle('open');
      });

      // 4. Modal Handling for Beat Clicks & Search
      const modal = document.getElementById('interactive-modal');
      const modalCloseBtn = document.getElementById('modal-close-btn');
      const modalTitle = document.getElementById('modal-title');
      const modalDesc = document.getElementById('modal-desc');
      const searchBtn = document.getElementById('search-btn');

      function openModal(title, desc) {
        if (modalTitle) modalTitle.textContent = title;
        if (modalDesc) modalDesc.textContent = desc;
        if (modal) {
          modal.classList.add('open');
          modal.setAttribute('aria-hidden', 'false');
        }
      }

      function closeModal() {
        if (modal) {
          modal.classList.remove('open');
          modal.setAttribute('aria-hidden', 'true');
        }
      }

      modalCloseBtn?.addEventListener('click', closeModal);
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      // Beats click preview
      document.querySelectorAll('.beat-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const beatName = btn.getAttribute(`data-beat-${currentLang}`) || btn.textContent.trim();
          if (currentLang === 'hi') {
            openModal(
              `${beatName} — जल्द उपलब्ध`,
              `The Litmus News का ${beatName} विशेष संपादकीय कवरेज और ग्राउंड रिपोर्ट्स तैयार कर रहा है। लॉन्च के साथ ही लाइव अपडेट प्राप्त करें।`
            );
          } else {
            openModal(
              `${beatName} — Launching Soon`,
              `The Litmus News is setting up dedicated investigative and regional reporting under ${beatName}. Full coverage will unlock at official launch.`
            );
          }
          if (mobileDrawer?.classList.contains('open')) {
            mobileDrawer.classList.remove('open');
          }
        });
      });

      // Search button click
      searchBtn?.addEventListener('click', () => {
        if (currentLang === 'hi') {
          openModal(
            'खोज डेस्क (Search Desk)',
            'संपूर्ण राजस्थान के 50 जिलों की आर्काइव एवं लाइव सर्च कार्यप्रणाली लॉन्च के साथ सक्रिय कर दी जाएगी।'
          );
        } else {
          openModal(
            'Search Desk (Pre-Launch)',
            'Archive search and live topic filtering across all 50 districts of Rajasthan will go live with our full newsroom launch.'
          );
        }
      });

      // 5. Newsletter Submission Form
      const newsletterForm = document.getElementById('newsletter-form');
      const emailInput = document.getElementById('email-input');
      const formFeedback = document.getElementById('form-feedback');

      newsletterForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        if (emailInput && emailInput.value) {
          if (formFeedback) {
            formFeedback.classList.add('success');
            formFeedback.textContent = currentLang === 'hi'
              ? 'धन्यवाद! हमने आपका ईमेल नोट कर लिया है। लॉन्च होते ही आपको सूचित किया जाएगा।'
              : 'Thank you! You will be the first to know when our newsroom goes live.';
          }
          emailInput.value = '';
        }
      });
    </script>
  </body>
</html>