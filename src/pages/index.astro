---
// The Litmus News - Editorial Light Theme with Terracotta & Serif Typography
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>The Litmus News | Getting Online</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      body {
        margin: 0;
        padding: 0;
        font-family: Georgia, Cambria, "Times New Roman", Times, serif;
        background-color: #f7f5f0; /* Editorial off-white / cream background */
        color: #1a1a1a;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        text-align: center;
        position: relative;
        overflow: hidden;
      }

      /* Warm terracotta interactive illumination spotlight */
      #spotlight {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        background: radial-gradient(
          700px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
          rgba(193, 114, 84, 0.12),
          transparent 75%
        );
        z-index: 1;
        transition: background 0.1s ease-out;
      }

      /* Top-Left Logo (No rounded corners, blends into cream background) */
      .top-left-logo {
        position: absolute;
        top: 28px;
        left: 28px;
        z-index: 10;
        display: flex;
        align-items: center;
      }
      .top-left-logo img {
        height: 36px;
        width: auto;
        display: block;
      }

      .container {
        max-width: 700px;
        padding: 40px 20px;
        z-index: 5;
        position: relative;
      }

      /* Center Logo (Sharp edges, no rounded boxes) */
      .center-logo-container {
        margin-bottom: 30px;
        display: inline-block;
      }
      .center-logo {
        height: 90px;
        width: auto;
        display: block;
        margin: 0 auto;
      }

      .badge {
        display: inline-block;
        background-color: #c17254; /* Terracotta badge */
        color: white;
        font-family: system-ui, -apple-system, sans-serif;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
        padding: 6px 14px;
        margin-bottom: 24px;
      }

      h1 {
        font-size: 3rem;
        margin-bottom: 16px;
        font-weight: 400;
        letter-spacing: -0.5px;
        line-height: 1.15;
      }

      h1 span {
        font-style: italic;
        color: #c17254; /* Terracotta accent text matching your screenshot style */
      }

      p {
        color: #555555;
        font-size: 1.2rem;
        line-height: 1.6;
        margin-bottom: 40px;
        font-family: Georgia, serif;
      }

      .cta-button {
        display: inline-block;
        background-color: #1a1a1a;
        color: white;
        text-decoration: none;
        font-family: system-ui, -apple-system, sans-serif;
        font-size: 0.95rem;
        font-weight: 600;
        padding: 14px 30px;
        transition: background-color 0.2s ease, transform 0.2s ease;
      }
      .cta-button:hover {
        background-color: #c17254; /* Turns terracotta on hover */
        transform: translateY(-2px);
      }
    </style>
  </head>
  <body>
    <!-- Interactive Terracotta Spotlight Overlay -->
    <div id="spotlight"></div>

    <!-- Top Left Corner Logo -->
    <div class="top-left-logo">
      <a href="/"><img src="/logo.png" alt="The Litmus News" /></a>
    </div>

    <div class="container">
      <!-- Center Logo -->
      <div class="center-logo-container">
        <img src="/logo.png" alt="The Litmus News" class="center-logo" />
      </div>

      <div class="badge">Rajasthan's Pulse Online</div>
      <h1>Connecting regional stories to <span>commercial and public impact.</span></h1>
      <p>We are building a clean, modern digital home for your trusted regional updates, ground reports, and breaking stories. Our full news desk is launching soon.</p>
      <a href="https://www.instagram.com/thelitmusnews/" target="_blank" class="cta-button">Follow Our Updates on Instagram</a>
    </div>

    <script>
      // Interactive Illumination Spotlight Script
      const spotlight = document.getElementById('spotlight');

      function updateSpotlight(clientX, clientY) {
        const x = (clientX / window.innerWidth) * 100;
        const y = (clientY / window.innerHeight) * 100;
        spotlight.style.setProperty('--mouse-x', `${x}%`);
        spotlight.style.setProperty('--mouse-y', `${y}%`);
      }

      window.addEventListener('mousemove', (e) => {
        updateSpotlight(e.clientX, e.clientY);
      });

      window.addEventListener('touchmove', (e) => {
        if (e.touches.length > 0) {
          updateSpotlight(e.touches[0].clientX, e.touches[0].clientY);
        }
      });

      updateSpotlight(window.innerWidth / 2, window.innerHeight / 2);
    </script>
  </body>
</html>
