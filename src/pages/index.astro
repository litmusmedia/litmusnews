---
// The Litmus News - Coming Soon with Google Tag Manager & Editorial Theme
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>The Litmus News | Getting Online</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google Tag Manager -->
    <script>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-T2HG49TH');
    </script>
    <!-- End Google Tag Manager -->

    <style>
      body {
        margin: 0;
        padding: 0;
        font-family: Georgia, Cambria, "Times New Roman", Times, serif;
        background-color: #f7f5f0;
        color: #1a1a1a;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        text-align: center;
        position: relative;
        overflow-x: hidden;
      }

      /* Warm terracotta interactive illumination spotlight */
      #spotlight {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        background: radial-gradient(
          700px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
          rgba(193, 114, 84, 0.12),
          transparent 75%
        );
        z-index: 1;
        transition: background 0.1s ease-out;
      }

      /* Top-Left Logo */
      .top-left-logo {
        position: absolute;
        top: 28px;
        left: 28px;
        z-index: 10;
        display: flex;
        align-items: center;
      }
      .top-left-logo img {
        height: 36px;
        width: auto;
        display: block;
        mix-blend-mode: multiply;
      }

      /* Strict Centered Layout Container */
      .container {
        max-width: 750px;
        width: 100%;
        padding: 40px 20px;
        z-index: 5;
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
      }

      /* Larger Center Logo positioned ABOVE the badge */
      .center-logo-container {
        margin-bottom: 18px;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
      }
      .center-logo {
        height: 130px;
        width: auto;
        display: block;
        mix-blend-mode: multiply;
      }

      .badge {
        display: inline-block;
        background-color: #c17254;
        color: white;
        font-family: system-ui, -apple-system, sans-serif;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
        padding: 6px 14px;
        margin-bottom: 24px;
      }

      h1 {
        font-size: 3rem;
        margin-bottom: 16px;
        font-weight: 400;
        letter-spacing: -0.5px;
        line-height: 1.15;
      }

      h1 span {
        font-style: italic;
        color: #c17254;
      }

      p {
        color: #555555;
        font-size: 1.2rem;
        line-height: 1.6;
        margin-bottom: 40px;
        font-family: Georgia, serif;
      }

      .cta-button {
        display: inline-block;
        background-color: #1a1a1a;
        color: white;
        text-decoration: none;
        font-family: system-ui, -apple-system, sans-serif;
        font-size: 0.95rem;
        font-weight: 600;
        padding: 14px 30px;
        transition: background-color 0.2s ease, transform 0.2s ease;
      }
      .cta-button:hover {
        background-color: #c17254;
        transform: translateY(-2px);
      }
    </style>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-T2HG49TH"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <!-- Interactive Terracotta Spotlight Overlay -->
    <div id="spotlight"></div>

    <!-- Top Left Corner Logo -->
    <div class="top-left-logo">
      <a href="/"><img src="/logo.png" alt="The Litmus News" /></a>
    </div>

    <div class="container">
      <!-- Center Logo positioned strictly ABOVE the badge -->
      <div class="center-logo-container">
        <img src="/logo.png" alt="The Litmus News" class="center-logo" />
      </div>

      <div class="badge">Rajasthan's Pulse Online</div>
      <h1>Connecting regional stories to <span>commercial and public impact.</span></h1>
      <p>We are building a clean, modern digital home for your trusted regional updates, ground reports, and breaking stories. Our full news desk is launching soon.</p>
      <a href="https://www.instagram.com/thelitmusnews/" target="_blank" class="cta-button">Follow Our Updates on Instagram</a>
    </div>

    <script>
      // Interactive Illumination Spotlight Script
      const spotlight = document.getElementById('spotlight');

      function updateSpotlight(clientX, clientY) {
        const x = (clientX / window.innerWidth) * 100;
        const y = (clientY / window.innerHeight) * 100;
        spotlight.style.setProperty('--mouse-x', `${x}%`);
        spotlight.style.setProperty('--mouse-y', `${y}%`);
      }

      window.addEventListener('mousemove', (e) => {
        updateSpotlight(e.clientX, e.clientY);
      });

      window.addEventListener('touchmove', (e) => {
        if (e.touches.length > 0) {
          updateSpotlight(e.touches[0].clientX, e.touches[0].clientY);
        }
      });

      updateSpotlight(window.innerWidth / 2, window.innerHeight / 2);
    </script>
  </body>
</html>
